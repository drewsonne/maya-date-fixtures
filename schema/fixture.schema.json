{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/drewsonne/maya-date-fixtures/schema/fixture.schema.json",
  "title": "Maya date fixture file",
  "description": "A fixture file is a list of records. Every expected value comes from a published source, an independent implementation, or hand calculation shown in notes — never from running the code under test.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "provenance"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "long_count": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)+$",
        "description": "Positional notation, dot-separated, e.g. 9.16.4.10.8. Winal is base-18; every other position base-20."
      },
      "calendar_round": { "type": "string" },
      "lord_of_night": { "type": "string", "pattern": "^G[1-9]$" },
      "maya_day_number": { "type": "integer" },
      "julian_day_number": { "type": "integer" },
      "gregorian_proleptic": {
        "type": "string",
        "pattern": "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}$"
      },
      "correlation": { "type": "integer" },
      "provenance": {
        "enum": ["attested", "derived", "unverified"],
        "description": "attested: published inscription, table or worked example, cited. derived: hand-calculated or independent implementation, derivation in notes. unverified: stated from memory, excluded from the trust gate."
      },
      "source": { "type": "string" },
      "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "notes": { "type": "string" }
    },
    "allOf": [
      {
        "if": { "properties": { "provenance": { "const": "attested" } }, "required": ["provenance"] },
        "then": {
          "required": ["source"],
          "properties": { "source": { "type": "string", "minLength": 1 } }
        }
      },
      {
        "if": { "properties": { "provenance": { "const": "derived" } }, "required": ["provenance"] },
        "then": {
          "required": ["notes"],
          "properties": { "notes": { "type": "string", "minLength": 1 } }
        }
      }
    ]
  }
}
